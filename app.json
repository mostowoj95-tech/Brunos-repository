{
  "expo": {
    "name": "Photo to ICS",
    "slug": "photo-to-ics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brunobischoff.phototoics",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Used to pick event flyer photos to extract calendar events.",
        "NSCameraUsageDescription": "Used to take photos of event flyers to extract calendar events."
      }
    },
    "android": {
      "package": "com.brunobischoff.phototoics",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Photo to ICS adds extracted events directly to a calendar on this device."
        }
      ]
    ]
  }
}
